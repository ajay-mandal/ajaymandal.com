# Supabase environment variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEO
# Canonical origin used for metadata, sitemap, robots and RSS (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ajaymandal.com
# Optional: Search Console / Bing Webmaster verification tokens (content of the meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
